{
  "name": "@frametalk/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "tsx src/api.ts",
    "start:worker": "tsx src/worker.ts",
    "prisma-generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "seed-demo": "tsx src/seed-demo.ts",
    "test": "vitest run",
    "test:compat": "tsx scripts/compat.ts"
  },
  "prisma": { "schema": "prisma/schema.prisma" },
  "dependencies": {
    "@frametalk/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.2",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "archiver": "^7.0.1",
    "basic-ftp": "^5.0.5",
    "fastify": "^5.2.1",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.0",
    "pg-boss": "^10.1.5",
    "socket.io": "^4.8.3",
    "tsx": "^4.20.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.7.0",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.4",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

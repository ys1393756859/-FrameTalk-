# 复制为同目录 .env 后修改
# 数据库密码（必填）
POSTGRES_PASSWORD=please-change-me

# 对外端口
APP_PORT=3000

# 宿主机媒体目录（RAID 盘挂载点）
MEDIA_DIR=/data/media

# 初始管理员（仅首次启动创建，之后请立即改密）
INITIAL_ADMIN_EMAIL=admin@local
INITIAL_ADMIN_PASSWORD=changeme123
INITIAL_ADMIN_NAME=管理员

# 原片归档存储：local（默认，全在本机媒体盘）| webdav | ftp
# 归档策略：转码产物（代理/封面/雪碧图/波形）始终在本地保证播放性能；
# 仅原片在转码完成后上传远端并删除本地副本，下载/重转码时自动回源。
STORAGE_BACKEND=local
# WebDAV 示例（Nextcloud / 群晖 / IIS WebDAV 等）
#STORAGE_BACKEND=webdav
#WEBDAV_BASE_URL=http://nas.local:5005/dav
#WEBDAV_USERNAME=user
#WEBDAV_PASSWORD=pass
# FTP 示例
#STORAGE_BACKEND=ftp
#FTP_HOST=nas.local
#FTP_PORT=21
#FTP_USER=user
#FTP_PASSWORD=pass
#FTP_SECURE=0
